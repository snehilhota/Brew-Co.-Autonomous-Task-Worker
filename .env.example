# Copy this file to .env and add your own API key.
# Never commit .env.
GEMINI_API_KEY=

# Keep agent and verifier model choices independently configurable.
AGENT_MODEL=gemini-3.8-flash
VERIFIER_MODEL=gemini-3.8-flash

# Local mock environment settings
APP_BASE_URL=http://127.0.0.1:5000
DATABASE_PATH=env/db/brew.sqlite3
SIMULATED_DATE=2026-10-05
