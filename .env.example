# Copy this file to .env and add your own API key.
# Never commit .env.
GEMINI_API_KEY=

# Keep agent and verifier model choices independently configurable.
AGENT_MODEL=gemini-3.8-flash
VERIFIER_MODEL=gemini-3.8-flash
LLM_MAX_REQUESTS_PER_RUN=12

# Local mock environment settings
APP_BASE_URL=http://127.0.0.1:5000
ENV_BASE_URL=http://127.0.0.1:5000
DATABASE_PATH=env/db/brew.sqlite3
# Optional fixed date for repeatable demos; leave unset to use today's date.
# APP_TODAY=2026-10-05

# Reliability experiments (keep off for normal runs)
CHAOS_SLOW_PAGE_MS=0
CHAOS_SUBMIT_500_ONCE=false
CHAOS_TIMEOUT_AFTER_COMMIT_ONCE=false
CHAOS_FLAKY_TOOL_RATE=0
DUPLICATE_GUARD=off
